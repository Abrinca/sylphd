{
  "service": "sylphd",
  "version": "<version>",
  "pysylph_version": "<version>",
  "python_version": "<version>",
  "database": {
    "name": "ecoli.syl2db",
    "path": "<path>",
    "size": 419015,
    "sha256": null,
    "genomes": 3,
    "c": 200,
    "k": 31,
    "screen_c": 3000,
    "two_stage": true
  },
  "metadata": null,
