# Caddyfile — TLS front end for a public sylphd instance.
#
# Installed to /etc/caddy/Caddyfile by setup-server.sh, which also writes the
# site address into a systemd drop-in (Environment=SYLPHD_DOMAIN=...) for
# caddy.service.  Without that variable the site falls back to `example.org`,
# so this file is always a valid Caddyfile you can test by hand:
#
#   SYLPHD_DOMAIN=sylphd.example.org caddy validate --config ./Caddyfile \
#       --adapter caddyfile
#
# Point the name at the host first (an A/AAAA record, or an sslip.io /
# nip.io name that encodes the IP).  Caddy obtains and renews the certificate
# via Let's Encrypt automatically; HTTP is redirected to HTTPS.
#
# Caddy runs confined as httpd_t from the @caddy/caddy package.  Talking to
# sylphd's Unix socket therefore needs two SELinux bits (both installed by
# setup-server.sh, see deploy/selinux/):
#   * /srv/sylphd/run is labelled httpd_var_run_t, which httpd_t may read/write;
#   * a small policy module grants httpd_t connectto on that socket type.
#
# The socket is 0660 sylphd:sylphd; user caddy is in group sylphd.  Caddy
# buffers nothing: request_body guards the upload path (well above the 20 MB
# /assembly limit and a typical batch of sketches), while sylphd enforces its
# own per-endpoint limits and returns the JSON 413.  Raise max_size only if you
# raise sylphd's --max-upload-mb.
#
# Access logs go to stderr, which systemd collects in the journal
# (journalctl -u caddy).

{$SYLPHD_DOMAIN:example.org} {
	encode zstd gzip

	request_body {
		max_size {$SYLPH_HTTP_MAX:64MB}
	}

	reverse_proxy unix//srv/sylphd/run/sylphd.sock {
		# Caddy would otherwise forward the client-supplied header; sylphd
		# trusts this one because --trusted-proxy unix is set.
		header_up X-Forwarded-For {remote_host}
	}

	log {
		format console
	}
}
