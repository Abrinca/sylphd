# Example site settings for setup-server.sh.  Copy to `site.env` (which is
# git-ignored) and edit.  This file is the template; the real one names a host.

# Public name Caddy serves.  An A/AAAA record must already point at the box.
# No DNS at hand?  sslip.io encodes the IPv4 address, e.g. 203-0-113-7.sslip.io
DOMAIN=example.org

# Database files inside /srv/sylphd/db (installed by hand, not by this repo).
# SYLPH_DB=gtdb-r232-c200-dbv2.syl2db
# SYLPH_META=meta-r232-reps.sqlite

# Site policy for `sylphd serve` — see deploy/sylphd.service for what the
# flags mean.  One whitespace-separated string, no quoting.
# SYLPH_SERVE_ARGS=--allow-sequences --max-jobs 2 --max-queue 16 --rate-limit 10/min --trusted-proxy unix --cors-origin * --terms-url https://example.org/terms

# Largest request body Caddy accepts (Caddyfile request_body max_size).
# SYLPH_HTTP_MAX=64MB
