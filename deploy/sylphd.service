# sylphd behind a reverse proxy; installed by setup-server.sh, which sets the
# site's databases, metadata and flags in sylphd.service.d/10-site.conf.
[Unit]
Description=sylphd — long-running sylph server
Documentation=https://abrinca.github.io/sylphd/docs/guides/public-server.html
After=network-online.target
Wants=network-online.target

[Service]
User=sylphd
Group=sylphd
WorkingDirectory=/srv/sylphd
Environment=HOME=/srv/sylphd PYTHONUNBUFFERED=1

# Defaults; setup-server.sh overrides them from site.env.  SYLPH_DB_ARGS is
# expanded unquoted so systemd splits it into one argument per --db.
Environment="SYLPH_DB_ARGS=--db /srv/sylphd/db/gtdb-r232-c200-dbv2.syl2db"
Environment=SYLPH_META=meta-r232-reps-v3.sqlite
Environment="SYLPH_SERVE_ARGS=--allow-sequences --max-jobs 2 --max-contigs 100 --max-queue 16 --rate-limit 10/min --trusted-proxy unix --cors-origin *"

ExecStart=/srv/sylphd/current/bin/sylphd serve \
    $SYLPH_DB_ARGS \
    --meta /srv/sylphd/db/${SYLPH_META} \
    --socket /srv/sylphd/run/sylphd.sock \
    --name=${SYLPH_NAME} \
    $SYLPH_SERVE_ARGS
KillSignal=SIGINT
TimeoutStartSec=180
Restart=always
RestartSec=5

# A request that needs more memory kills sylphd (which restarts in seconds),
# not the host.  Page cache is reclaimed before this limit is hit.
MemoryMax=8G
MemorySwapMax=0

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/sylphd/run -/srv/sylphd/usage
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027

[Install]
WantedBy=multi-user.target
